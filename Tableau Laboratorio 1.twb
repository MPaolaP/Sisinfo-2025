      <column caption='ventas_canal' datatype='real' name='[Calculation_395753871404797953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 1] = &apos;1&apos; AND [canal_venta] = &quot;Online&quot; THEN [Calculation_778278363848835073]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;2&apos; AND [canal_venta] = &quot;Tienda&quot; THEN [Calculation_778278363848835073]&#13;&#10;ELSEIF [Parameters].[Parámetro 1] = &apos;3&apos; THEN [Calculation_778278363848835073]&#13;&#10;END' />
      </column>
      <column caption='ventas_imp' datatype='real' name='[Calculation_778278363848835073]' role='measure' type='quantitative'>
